# ── Usadas pelo app (navegador) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chave pública VAPID (gerada com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Nome do bot do Telegram, sem @ (ex.: NinhoDaCasaBot) — opcional
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── SÓ servidor (Vercel → Settings → Environment Variables; nunca NEXT_PUBLIC_) ──
# Supabase → Project Settings → API → service_role (secreta: ignora a RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Chave privada VAPID (par da pública acima)
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo de push
VAPID_SUBJECT=mailto:seu-email@exemplo.com
# Segredo que a Vercel manda nas chamadas agendadas (qualquer texto longo e aleatório)
CRON_SECRET=
# Telegram (opcional): token do @BotFather (secreto) e um segredo qualquer para o webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# IA (opcional): chave da Anthropic (console.anthropic.com → API Keys) — secreta
ANTHROPIC_API_KEY=
